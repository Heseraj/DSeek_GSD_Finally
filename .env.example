# FinAlly environment configuration
# Copy this file to .env and fill in the values. The backend loads the
# project-root .env at import time (load_dotenv in backend/app/main.py).

# Required for live chat via OpenRouter (LiteLLM). Leave blank for mock mode.
OPENROUTER_API_KEY=

# Set to "true" for deterministic mock responses (no API key needed).
LLM_MOCK=false

# Optional: set to use the Massive (Polygon.io) market data provider for real
# market data instead of the simulated GBM source.
MASSIVE_API_KEY=
